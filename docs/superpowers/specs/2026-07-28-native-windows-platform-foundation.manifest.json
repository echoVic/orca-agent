      "std::os::unix::"
    ],
    [
      "unix_libc_process",
      "libc::(?:flock|kill|killpg|setsid|setpgid|fcntl|SIGTERM|SIGKILL|LOCK_EX|LOCK_NB|LOCK_UN|O_NONBLOCK|O_CLOEXEC|O_NOFOLLOW)"
    ],
    [
      "unix_flock_ffi",
      "fn (?:owner_)?flock\\(fd: i32, operation: i32\\)"
    ],
    [
      "non_unix_lock_stub",
      "#\\[cfg\\(not\\(unix\\)\\)\\][\\s\\S]{0,160}?fn (?:try_lock_runtime_file|try_lock_exclusive|unlock_exclusive|lock_file_impl|unlock_file_impl)\\b"
    ],
    [
      "direct_temp_rename",
      "(?:std::fs::rename|fs::rename)\\(\\s*&?temp_path\\b"
    ]
