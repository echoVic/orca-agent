{
  "schemaVersion": 1,
  "package": "@blade-ai/orca",
  "website": "https://orcaagent.dev",
  "commands": {
    "root": ["doctor", "storage", "rewind", "exec", "app-server", "acp", "workflow", "trust", "mcp", "daemon", "acp-bridge", "attach"],
    "doctor": {
      "options": ["--cwd", "--format", "--json"],
      "subcommands": []
    },
    "storage": {
      "options": ["--max-bytes", "--older-than-days", "--apply"],
      "subcommands": []
    },
    "rewind": {
      "options": ["--last", "--at", "--mode", "--dry-run", "--json", "--force", "--rollback", "--prune"],
      "subcommands": []
    },
    "exec": {
      "options": [
        "--output-format",
        "--json",
        "--cwd",
        "--mode",
        "--yolo",
        "--plan",
        "--model",
        "--api-key",
        "--base-url",
        "--verifier",
        "--max-turns",
        "--max-tool-calls",
        "--max-cost-usd",
        "--max-wall-time-secs",
        "--resume",
        "--resume-at",
        "--fork",
        "--continue",
        "--no-history",
        "--save-history"
      ],
      "subcommands": ["resume"]
    },
    "app-server": {
      "options": ["--cwd", "--model", "--api-key", "--base-url"],
      "subcommands": []
    },
    "acp": {
      "options": ["--cwd", "--model", "--api-key", "--base-url"],
      "subcommands": []
    },
    "workflow": {
      "options": [],
      "subcommands": [
        "run",
        "list",
        "show",
        "source",
        "stop",
        "pause",
        "resume",
        "clone",
        "restart-failed",
        "restart-phase"
      ]
    },
    "trust": {
      "options": ["--cwd"],
      "subcommands": []
    },
    "mcp": {
      "options": [],
      "subcommands": ["add", "list", "get", "remove", "login", "logout"]
    },
    "daemon": {
      "options": ["--socket", "--cwd"],
      "subcommands": []
    },
    "acp-bridge": {
      "options": ["--socket"],
      "subcommands": []
    },
    "attach": {
      "options": ["--socket", "--cwd", "--exec"],
      "subcommands": []
    }
  }
}
