{
  "schemaVersion": 1,
  "package": "@blade-ai/orca",
  "website": "https://orcaagent.dev",
  "commands": {
    "root": ["doctor", "storage", "exec", "workflow", "trust"],
    "doctor": {
      "options": ["--cwd", "--format"],
      "subcommands": []
    },
    "storage": {
      "options": ["--max-bytes", "--older-than-days", "--apply"],
      "subcommands": []
    },
    "exec": {
      "options": [
        "--output-format",
        "--cwd",
        "--mode",
        "--model",
        "--api-key",
        "--base-url",
        "--verifier",
        "--max-turns",
        "--max-tool-calls",
        "--max-cost-usd",
        "--max-wall-time-secs",
        "--resume",
        "--resume-at",
        "--fork",
        "--continue",
        "--no-history",
        "--save-history"
      ],
      "subcommands": ["resume"]
    },
    "workflow": {
      "options": [],
      "subcommands": [
        "run",
        "list",
        "show",
        "source",
        "stop",
        "pause",
        "resume",
        "clone",
        "restart-failed",
        "restart-phase"
      ]
    },
    "trust": {
      "options": ["--cwd"],
      "subcommands": []
    }
  }
}
